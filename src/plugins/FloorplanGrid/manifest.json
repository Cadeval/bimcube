{
  "id": "floorplan-grid",
  "name": "Floorplan Grid",
  "version": "0.0.2",
  "description": "Procedural Multi-Storey BIM Generator.",
  "inputs": {
    "siteCoords": { "type": "location", "label": "Site Coordinates", "defaultValue": "48.225023, 16.330946, 0", "optional": true },
    "widthX": { "type": "range", "label": "Length (X)", "min": 20.5, "max": 28, "step": 0.5, "defaultValue": 22, "optional": true },
    "depthY": { "type": "range", "label": "Depth (Y)", "min": 15, "max": 19, "step": 0.5, "defaultValue": 16, "optional": true },
    "storeyCount": { "type": "range", "label": "Typical Stories", "min": 1, "max": 8, "step": 1, "defaultValue": 3, "optional": true },
    "hGround": { "type": "range", "label": "Ground Height (Z)", "min": 2.5, "max": 6.0, "step": 0.1, "defaultValue": 3.6, "optional": true },
    "hTypical": { "type": "range", "label": "Typical Height (Z)", "min": 2.8, "max": 5.0, "step": 0.1, "defaultValue": 3.2, "optional": true },
    "hParapet": { "type": "range", "label": "Parapet Height (Z)", "min": 0.2, "max": 3.0, "step": 0.1, "defaultValue": 0.8, "optional": true },
    "colorCW1": { "type": "color", "label": "Color Front/Back", "defaultValue": "#cfd8dc", "optional": true },
    "colorCW2": { "type": "color", "label": "Color Sides", "defaultValue": "#fafafa", "optional": true },
    "colorGlass": { "type": "color", "label": "Glass / Window Color", "defaultValue": "#8ab4f8", "optional": true },
    "alignType": { "type": "select", "label": "Panel Alignment", "options": ["left", "center", "right"], "defaultValue": "center", "optional": true },
    "hWindow": { "type": "range", "label": "Window Height (Z)", "min": 1.9, "max": 4.0, "step": 0.1, "defaultValue": 2.4, "optional": true },
    "wPanelGround": { "type": "range", "label": "Ground Glass Width", "min": 0.5, "max": 6.0, "step": 0.1, "defaultValue": 1.6, "optional": true },
    "wPanelV": { "type": "range", "label": "Panel V Width", "min": 0.2, "max": 2.0, "step": 0.1, "defaultValue": 0.8, "optional": true },
    "wPanelH": { "type": "range", "label": "Panel H Width", "min": 0.5, "max": 6.0, "step": 0.1, "defaultValue": 2.4, "optional": true }
  },
  "outputs": {
    "description": "Parametric Highrise Generation"
  }
}