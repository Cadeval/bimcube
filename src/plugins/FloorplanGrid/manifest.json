{
  "id": "floorplan-grid",
  "name": "Floorplan Grid",
  "version": "1.1.0",
  "description": "Multi-storey parametric grid with cumulative Z-heights.",
  "inputs": {
    "widthX": { "type": "range", "label": "Width (X)", "min": 22, "max": 28, "step": 0.5, "defaultValue": 22 },
    "depthY": { "type": "range", "label": "Depth (Y)", "min": 16, "max": 19, "step": 0.5, "defaultValue": 16 },
    "h00": { "type": "number", "label": "Level 00 Room Height", "defaultValue": 3.22 },
    "h01": { "type": "number", "label": "Level 01 Room Height", "defaultValue": 3.22 },
    "h02": { "type": "number", "label": "Level 02 Room Height", "defaultValue": 3.22 }
  },
  "outputs": {
    "description": "Annotated 3D coordinates"
  }
}