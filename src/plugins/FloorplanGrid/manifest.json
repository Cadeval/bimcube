{
  "id": "floorplan-grid",
  "name": "Floorplan Grid",
  "version": "2.0.0",
  "description": "Procedural Multi-Storey BIM Generator.",
  "inputs": {
    "widthX": { "type": "range", "label": "Width (X)", "min": 21.5, "max": 28, "step": 0.5, "defaultValue": 22 },
    "depthY": { "type": "range", "label": "Depth (Y)", "min": 15, "max": 19, "step": 0.5, "defaultValue": 16 },
    "storeyCount": { "type": "range", "label": "Typical Stories", "min": 1, "max": 8, "step": 1, "defaultValue": 2 },
    "hGround": { "type": "range", "label": "Ground Height", "min": 3.2, "max": 6.0, "step": 0.1, "defaultValue": 3.6 },
    "hTypical": { "type": "range", "label": "Typical Height", "min": 3.0, "max": 4.2, "step": 0.1, "defaultValue": 3.2 },
    "hWindow": { "type": "range", "label": "Window Height", "min": 2.1, "max": 3.6, "step": 0.1, "defaultValue": 2.4 },
    "wPilaster": { "type": "range", "label": "Vertical Panel Width", "min": 0.4, "max": 5.0, "step": 0.1, "defaultValue": 0.8 },
    "hParapet": { "type": "range", "label": "Parapet Height", "min": 0.4, "max": 1.2, "step": 0.1, "defaultValue": 0.8 }
  },
  "outputs": {
    "description": "Parametric Highrise Generation"
  }
}