{
  "id": "grid-generator",
  "name": "Grid Generator",
  "version": "1.0.0",
  "description": "Generates a 2D grid based on X and Y parameters.",
  "inputs": {
    "xWidth": {
      "type": "range",
      "label": "X Width",
      "min": 1,
      "max": 50,
      "step": 1,
      "defaultValue": 10,
      "optional": true
    },
    "yWidth": {
      "type": "range",
      "label": "Y Width",
      "min": 1,
      "max": 50,
      "step": 1,
      "defaultValue": 10,
      "optional": true
    }
  },
  "outputs": {
    "description": "Array of 2D coordinates representing grid intersections."
  }
}