{
  "id": "box-generator",
  "name": "Box Generator",
  "version": "0.0.1",
  "type": "Plugin",
  "description": "Generates a solid 3D box.",
  "inputs": {
    "width": { "type": "range", "label": "Width", "min": 1, "max": 20, "step": 1, "defaultValue": 5, "optional": true},
    "height": { "type": "range", "label": "Height", "min": 1, "max": 20, "step": 1, "defaultValue": 5, "optional": true},
    "depth": { "type": "range", "label": "Depth", "min": 1, "max": 20, "step": 1, "defaultValue": 5, "optional": true},
    "color": { "type": "color", "label": "Box Color", "defaultValue": "#4af626", "optional": true}
  },
  "outputs": {
    "description": "Solid 3D Mesh properties"
  }
}