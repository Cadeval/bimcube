{
  "id": "box-generator",
  "name": "Box Generator",
  "version": "1.0.0",
  "description": "Generates a solid 3D box.",
  "inputs": {
    "width": { "type": "range", "label": "Width", "min": 1, "max": 20, "step": 1, "defaultValue": 5 },
    "height": { "type": "range", "label": "Height", "min": 1, "max": 20, "step": 1, "defaultValue": 5 },
    "depth": { "type": "range", "label": "Depth", "min": 1, "max": 20, "step": 1, "defaultValue": 5 },
    "color": { "type": "color", "label": "Box Color", "defaultValue": "#4af626" }
  },
  "outputs": {
    "description": "Solid 3D Mesh properties"
  }
}